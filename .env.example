GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# Overall multi-stage budget, per-attempt budget, and browser request budget (milliseconds).
GEMINI_GENERATION_TIMEOUT_MS=350000
GEMINI_ATTEMPT_TIMEOUT_MS=180000
VITE_UI_GENERATION_TIMEOUT_MS=370000

# Public Firebase project identifier used for server ID-token verification.
FIREBASE_PROJECT_ID=frame-44bbd

# Output budgets include thinking tokens; truncation fails safely without retrying at a higher cap.
GEMINI_SPEC_MAX_OUTPUT_TOKENS=10000
GEMINI_DESIGN_MAX_OUTPUT_TOKENS=24000
GEMINI_REPAIR_MAX_OUTPUT_TOKENS=20000
# Physical provider repair requests per generation, including rendered repair and transport retries.
GEMINI_MAX_REPAIR_CALLS=2

# USD per million standard text/image tokens, for estimates only (not billing activation).
# Verify against Google pricing and your project tier; model must match before overrides apply.
GEMINI_PRICING_MODEL=gemini-3.1-flash-lite
GEMINI_INPUT_USD_PER_MILLION=0.25
GEMINI_OUTPUT_USD_PER_MILLION=1.50
